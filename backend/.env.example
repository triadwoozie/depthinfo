# Sonar Imaging Backend — Environment Variables (see AGENTS.md § 8)
# Copy to .env and adjust for your setup.

# true = synthetic audio + camera frames, no hardware required (CI always uses this)
SONAR_MOCK_MODE=false

# Audio sample rate (Hz) — must match your audio interface
SONAR_SAMPLE_RATE=48000

# sounddevice device index. Leave blank to use system default.
# Run: python -c "import sounddevice; print(sounddevice.query_devices())"
# SONAR_AUDIO_DEVICE=0

# Camera device index for OpenCV
SONAR_CAMERA_INDEX=0

# Blender live-viewport UDP target
SONAR_UDP_HOST=127.0.0.1
SONAR_UDP_PORT=5005
SONAR_UDP_HZ=60

# WebSocket telemetry rate (Hz)
SONAR_WS_HZ=20

# Depth-Anything-V2-Small ONNX weights (relative to backend/). A procedural fallback
# depth map is used when the file is missing; set DEPTH_AUTO_DOWNLOAD=true to fetch it.
DEPTH_MODEL_PATH=models/depth_anything_v2_vits.onnx
DEPTH_AUTO_DOWNLOAD=false

# Static export output directory ("backend/exports" is repo-relative, plain names backend-relative)
EXPORTS_DIR=exports

# Blender 4.2+/5.x executable for POST /api/export/blend.
# Auto-detected from PATH or ~/blender*/blender when unset.
# BLENDER_BIN=/path/to/blender
