# Sonar Imaging Backend — Environment Variables (see AGENTS.md § 8)
# Copy to .env and adjust for your setup.

# true = synthetic audio + camera frames, no hardware required (CI always uses this)
SONAR_MOCK_MODE=false

# Audio sample rate (Hz) — must match your audio interface. Default for hardware.sample_rate_hz;
# a value saved in config_state.json takes precedence.
SONAR_SAMPLE_RATE=48000

# Audio devices are chosen in the dashboard (Hardware and rig) and saved by name in
# config_state.json; list them with: curl localhost:8000/api/devices

# Camera device index for OpenCV. Default for hardware.camera_device_index (the dashboard's
# camera picker, saved in config_state.json, takes precedence).
SONAR_CAMERA_INDEX=0

# true = use the real camera even in mock mode (synthetic sonar, live video)
SONAR_REAL_CAMERA=false

# Blender live-viewport UDP target. SONAR_UDP_HZ is how often the bridge checks for a new
# depth frame; each frame is sent once, so the real rate follows the camera.
SONAR_UDP_HOST=127.0.0.1
SONAR_UDP_PORT=5005
SONAR_UDP_HZ=60

# WebSocket telemetry rate (Hz)
SONAR_WS_HZ=20

# Depth-Anything-V2-Small ONNX weights (relative to backend/), used by the neural_onnx depth
# mode. If the file is missing that mode reports it and runs the fast heuristic instead;
# set DEPTH_AUTO_DOWNLOAD=true to fetch it (99 MB) on first use.
DEPTH_MODEL_PATH=models/depth_anything_v2_vits.onnx
DEPTH_AUTO_DOWNLOAD=false

# Static export output directory ("backend/exports" is repo-relative, plain names backend-relative)
EXPORTS_DIR=exports

# Blender 4.2+/5.x executable for POST /api/export/blend.
# Auto-detected from PATH or ~/blender*/blender when unset.
# BLENDER_BIN=/path/to/blender
